# Скопируйте этот файл в backend\.env и при необходимости поправьте значения.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="banetskaya_db"
CORS_ORIGINS="*"
# LibreOffice (нужен для PDF и печати).
# В установщике LibreOffice уже ВШИТ — приложение найдёт его само.
# Раскомментируйте и укажите путь ТОЛЬКО если используете свою установку LibreOffice:
# SOFFICE_BIN="C:\Program Files\LibreOffice\program\soffice.exe"
